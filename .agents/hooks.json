{
  "sql-readonly-firewall": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"../agentes/herramientas/firewall_sql_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
